# Copy to .env and fill in whichever you have. The bench runs any subset.
# Comments must be on their own line — a value is everything after the "=".
#
# With none of these set it runs the MOCK provider and stamps every output as
# non-evidential. See BLINDSPOTS.md #20.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# https://aistudio.google.com/apikey  — free tier, no card
GOOGLE_API_KEY=

# Local, free, no key, no data leaving the machine.
# Models are auto-discovered: whatever `ollama list` shows becomes a column.
OLLAMA_HOST=http://127.0.0.1:11434

# Hard ceiling on real spend. Checked before every call. Ignored for mock runs.
BENCH_MAX_USD=5.00
